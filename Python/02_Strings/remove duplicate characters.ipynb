   "source": [
    "def fun(s):\n",
    "    l=[]\n",
    "    for i in s:\n",
    "        if i not in l:\n",
    "            l.append(i)\n",
    "    return \" \".join(l)\n",
    "s=\"rohitranvirsantosh\"\n",
    "fun(s)"
   ]
