   ],
   "source": [
    "def fun(s):\n",
    "    l=set()\n",
    "    for i in s:\n",
    "        l.add(i)\n",
    "    return \" \".join(l)\n",
    "s=\"rohitranvirsantosh\"\n",
    "fun(s)"
   ]
