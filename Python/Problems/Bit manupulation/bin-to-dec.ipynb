    "def dectobin(n):\n",
    "    res=\"\"\n",
    "    while n>0:\n",
    "        if n%2==1:\n",
    "            res+=\"1\"\n",
    "        else:\n",
    "            res+=\"0\"\n",
    "        n=n//2\n",
    "    result=res[::-1]\n",
    "    return int(result)\n",
    "dectobin(13)"
   ]
