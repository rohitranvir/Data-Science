    "l=[-2,1,-3,4,-1,2,1,-5,4]\n",
    "\n",
    "t=float('-inf')\n",
    "res=0\n",
    "for i in range(0,len(l)):\n",
    "    res+=l[i]\n",
    "    t=max(res,t)\n",
    "    if res<0:\n",
    "        res=0\n",
    "print(t)"
