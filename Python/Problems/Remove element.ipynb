   "source": [
    "def remove_element(nums,val):\n",
    "    k=0\n",
    "    for i in range(len(nums)-1):\n",
    "        if nums[i]!=val:\n",
    "            nums[k]=nums[i]\n",
    "            k+=1\n",
    "            \n",
    "    return nums[:k]\n",
    "     \n",
    "nums = [0,1,2,2,3,0,4,2]\n",
    "val = 2\n",
    "remove_element(nums,val)"
   ]
  }
 ],
