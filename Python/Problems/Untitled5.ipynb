    "def staircase(n):\n",
    "    for i in range(n):\n",
    "        for j in range(n-(1+i)):\n",
    "            print(\" \",end=\"\")\n",
    "        for k in range(i+1):\n",
    "            print(\"#\",end=\"\") \n",
    "        print()\n",
    "staircase(10)"
   ]
