   "source": [
    "def findMin(nums):\n",
    "    m=float('inf')\n",
    "    for i in range(len(nums)):\n",
    "        m=min(nums[i],m)\n",
    "    return m\n",
    "nums=[3,4,5,1,2]\n",
    "findMin(nums)"
   ]
