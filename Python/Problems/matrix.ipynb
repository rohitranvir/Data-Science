   "source": [
    "m=[[5,10,8],\n",
    "   [7,6,3],\n",
    "   [2,1,9]\n",
    "  ]\n",
    "for i in range(len(m)):\n",
    "    for j in range(len(m[0])):\n",
    "        if j<i:\n",
    "            print('*',end=' ')\n",
    "        else:\n",
    "            print(m[i][j], end=' ')\n",
    "    print()\n",
    "            \n",
    "\n"
   ]
