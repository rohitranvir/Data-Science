    "def permut(nums):\n",
    "    pos=0\n",
    "    for i in range(1,len(nums)):\n",
    "        nums[len(nums)-1]=nums[pos+1]\n",
    "    return nums\n",
    "nums = [1,2,3]\n",
    "permut(nums)"
   ]
