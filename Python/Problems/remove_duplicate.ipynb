    "def remove_dup(nums):\n",
    "    count=0\n",
    "    pos=1\n",
    "    for i in range(1,len(nums)):\n",
    "        if nums[i]!=nums[i-1]:  \n",
    "            nums[pos]=nums[i]\n",
    "            pos+=1\n",
    "    return pos\n",
    "nums = nums = [0,0,1,1,1,2,2,3,3,4]\n",
    "k=remove_dup(nums)\n",
    "print(k)\n",
    "print(nums[:k])"
   ]
