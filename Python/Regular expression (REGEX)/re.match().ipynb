   "source": [
    "# Checks for a match only at the beginning of the string"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "590c386f-cc82-4920-ba31-0dc9fbde75ea",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<re.Match object; span=(0, 6), match='Python'>\n",
      "<re.Match object; span=(10, 15), match='power'>\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "text = \"Python is powerful\"\n",
    "\n",
    "# match\n",
    "print(re.match(\"Python\", text))\n",
    "\n",
    "# search\n",
    "print(re.search(\"power\", text))"
   ]
  },
