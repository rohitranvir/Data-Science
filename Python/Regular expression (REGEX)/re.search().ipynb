   "source": [
    "# Searches the entire string for the first match"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "bb695b53-f241-4a97-9545-99447678160c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Match found: powerful\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "text = \"Python is powerful\"\n",
    "\n",
    "result = re.search(\"powerful\", text)\n",
    "\n",
    "if result:\n",
    "    print(\"Match found:\", result.group())\n",
    "else:\n",
    "    print(\"No match\")"
   ]
  },
