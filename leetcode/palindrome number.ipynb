    "def pali(x):\n",
    "    \n",
    "        s1=x\n",
    "    s=0\n",
    "    while x>0:\n",
    "        t=x%10\n",
    "        s=s*10+t\n",
    "        x=x//10\n",
    "    if s1==s:\n",
    "        return True\n",
    "    elif x < 0 or s1!=s:\n",
    "        return False\n",
    "x=121\n",
    "\n",
    "pali(x)"
   ]
